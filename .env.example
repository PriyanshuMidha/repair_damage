NEXT_PUBLIC_APP_URL=https://your-deployed-repair-app.com
CAPACITOR_SERVER_URL=https://your-deployed-repair-app.com
STORAGE_MODE=auto
MONGODB_URI=
MONGODB_DB_NAME=Damaged_goods_tracked_cleanly
MONGODB_REPAIRS_COLLECTION=data
MONGODB_PARTIES_COLLECTION=party
# Required in production. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
# Seeded once on first boot against an empty users collection. Required in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Plazer@123
STAFF_USERNAME=staff
STAFF_PASSWORD=
# Required to enable photo deletion; leave unset to disable the feature.
PHOTO_DELETE_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_LIMIT_GB=9.5
R2_USAGE_PREFIX=repairs/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=repair-app/repairs
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
